# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# =============================================================================
# UNCENSORED META-SEARCH ENGINE – API Keys (all optional)
# Without any keys, 7 free providers still work out of the box.
# =============================================================================

# --- Brave Search (independent index, not Google/Bing) ---
# Free tier: 2,000 queries/month  |  Sign up: https://api.search.brave.com/
# Adds: Brave's own web crawl with privacy-first, uncensored ranking
BRAVE_SEARCH_API_KEY=

# --- Semantic Scholar (200M+ academic papers) ---
# Free public API – key only needed for higher rate limits
# Sign up: https://www.semanticscholar.org/product/api
# Adds: full academic paper database, open-access PDFs, citation graph
SEMANTIC_SCHOLAR_API_KEY=

# --- GitHub (repositories, issues, code) ---
# Free without token (10 req/min)  |  5,000 req/hr with token
# Create token: https://github.com/settings/tokens (no scopes needed for public)
# Adds: leaked documents, security research, whistleblower repos
GITHUB_TOKEN=

# --- Marginalia (independent non-commercial web index) ---
# Optional key for extended results  |  https://marginalia-search.com/
# Adds: personal blogs, old forums, niche sites buried by Google SEO
MARGINALIA_API_KEY=

# --- OpenCorporates (200M+ company records, corporate transparency) ---
# Optional token for higher rate limits  |  https://opencorporates.com/api_accounts/new
# Enables: corporate structure research, beneficial ownership, shell company tracing
OPENCORPORATES_API_KEY=

# --- Search result cache TTL (seconds, default 300 = 5 minutes) ---
SEARCH_CACHE_TTL=300

# Free providers that need NO key:
#   DuckDuckGo   – ad-free, no tracking, HTML scraping
#   HackerNews   – full discussion archive via Algolia API
#   Reddit        – public JSON API (include_over_18=on, no filter)
#   Wikipedia     – MediaWiki full-text search
#   arXiv         – official preprint API (all disciplines)
#   Internet Archive – deleted/censored pages, 800B+ web captures
#   Ahmia.fi      – largest public Tor (.onion) site index (clearnet access)